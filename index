<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>QuickTicket — User</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Inter,Arial,sans-serif;background:#f6f7fb;color:#182033}
header{position:sticky;top:0;z-index:20;background:rgba(16,20,38,.96);backdrop-filter:blur(10px);color:#fff;padding:14px 6%;display:flex;align-items:center;justify-content:space-between}
.logo{font-size:24px;font-weight:900;color:#ff5366}.logo span{color:#fff}nav button{background:none;border:0;color:#e9ebf3;margin-left:16px;cursor:pointer;font-weight:700}nav button:hover{color:#ff5366}
.page{display:none}.page.active{display:block}.hero{min-height:470px;padding:80px 6%;display:flex;align-items:center;justify-content:space-between;gap:35px;color:#fff;background:linear-gradient(110deg,#101426 20%,#252c4a 70%,#394264)}
.hero-text{max-width:610px}.hero h1{font-size:54px;line-height:1.05;margin:0 0 15px}.hero h1 span{color:#ff5366}.hero p{font-size:18px;color:#d7dbea;line-height:1.7}.hero-img{width:min(390px,42vw);height:290px;object-fit:cover;border-radius:24px;box-shadow:0 25px 70px rgba(0,0,0,.35);transform:rotate(2deg)}
.btn{border:0;border-radius:10px;padding:13px 20px;background:#ff5366;color:#fff;font-weight:800;cursor:pointer}.btn:hover{filter:brightness(1.08);transform:translateY(-1px)}
.section{padding:48px 6%}.section h2{text-align:center;font-size:32px;margin:0 0 8px}.subtitle{text-align:center;color:#72798b;margin:0 0 28px}
.movies{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.movie{background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 10px 30px rgba(21,26,45,.09);transition:.2s}.movie:hover{transform:translateY(-5px)}.movie img{width:100%;height:250px;object-fit:cover}.movie-content{padding:20px}.movie-content h3{margin:0 0 8px}.movie-content p{color:#687083;margin:7px 0}.movie .btn{width:100%;margin-top:13px}
.features{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px}.feature{background:#fff;padding:25px;border-radius:16px;text-align:center;box-shadow:0 8px 25px rgba(0,0,0,.06)}.feature .ico{font-size:35px}
.card{background:#fff;padding:30px;border-radius:18px;box-shadow:0 10px 30px rgba(21,26,45,.08);max-width:650px;margin:auto}label{display:block;font-weight:800;margin:13px 0 6px}input{width:100%;padding:13px;border:1px solid #d9ddea;border-radius:9px}.card form .btn{width:100%;margin-top:18px}
.msg{margin-top:14px;padding:11px;border-radius:9px;text-align:center}.success{background:#e8f8ef;color:#168653}.error{background:#ffecef;color:#c62828}
.booking-card{max-width:760px}.seat-head{display:flex;justify-content:space-between;align-items:center;margin:25px 0 12px}.small-btn{border:1px solid #d9ddea;background:#fff;border-radius:8px;padding:9px 12px;cursor:pointer}.screen{margin:15px auto 22px;max-width:430px;text-align:center;background:#202638;color:#fff;padding:8px;border-radius:50%/100%;letter-spacing:3px;font-size:12px}.seat-map{display:grid;grid-template-columns:repeat(10,1fr);gap:8px}.seat{border:0;border-radius:7px;padding:9px 2px;background:#e7f8ef;color:#168653;cursor:pointer;font-weight:800}.seat.selected{background:#ff5366;color:#fff}.seat.booked{background:#d8dce5;color:#747b8a;cursor:not-allowed}.seat-legend{display:flex;gap:18px;justify-content:center;flex-wrap:wrap;color:#687083;margin:18px}.dot{display:inline-block;width:13px;height:13px;border-radius:4px;vertical-align:middle;margin-right:5px}.available{background:#e7f8ef;border:1px solid #168653}.selected{background:#ff5366}.booked{background:#d8dce5}.summary{background:#f5f6fa;border-radius:10px;padding:14px;line-height:1.8}
.booking-list{max-width:700px;margin:auto}.booking-item{background:#fff;padding:20px;border-radius:14px;margin:12px 0;box-shadow:0 6px 20px rgba(0,0,0,.06)}
.ticket{max-width:850px;margin:auto;background:#fff;border-radius:18px;overflow:hidden;display:grid;grid-template-columns:2fr 1fr;box-shadow:0 15px 45px rgba(0,0,0,.12)}.ticket-main{padding:30px}.ticket-side{background:#151a2d;color:#fff;display:flex;align-items:center;justify-content:center;text-align:center}.qr{font-size:85px}.ticket-row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #eee}.actions{display:flex;gap:10px;margin-top:18px}.actions .btn{flex:1}
footer{background:#101426;color:#fff;text-align:center;padding:25px;margin-top:30px}
@media(max-width:850px){.hero{flex-direction:column;text-align:center}.hero-img{width:85%;}.movies,.features{grid-template-columns:1fr}.hero h1{font-size:40px}nav button{margin-left:7px;font-size:12px}.ticket{grid-template-columns:1fr}.seat-map{grid-template-columns:repeat(5,1fr)}}
</style>
</head>
<body>
<header><div class="logo">🎟️ <span>Quick</span>Ticket</div><nav>
<button onclick="show('home')">Home</button><button onclick="show('movies')">Movies</button><button onclick="show('booking')">Book</button><button onclick="show('myBookings')">My Bookings</button><button onclick="show('login')">Login</button>
</nav></header>

<section id="home" class="page active">
<div class="hero"><div class="hero-text"><h1>Your Seat.<br><span>Your Movie.</span><br>Your Moment.</h1><p>Discover movies, select your favourite seats and get a digital ticket in seconds.</p><button class="btn" onclick="show('movies')">🎬 Explore Movies</button></div><img class="hero-img" src="assets/m3.jpg" alt="Movie poster"></div>
<div class="section"><h2>Why QuickTicket?</h2><p class="subtitle">A simple demo ticket-booking experience for customers.</p><div class="features"><div class="feature"><div class="ico">🎟️</div><h3>Easy Booking</h3><p>Pick a movie, show and seats in a few clicks.</p></div><div class="feature"><div class="ico">💺</div><h3>Live Seats</h3><p>Booked seats are disabled automatically.</p></div><div class="feature"><div class="ico">📱</div><h3>Digital Ticket</h3><p>View and print your confirmed ticket instantly.</p></div></div></div>
</section>

<section id="movies" class="page"><div class="section"><h2>Latest & Upcoming</h2><p class="subtitle">Choose a title to continue.</p><div class="movies">
<div class="movie"><img src="assets/m2.webp" alt="Telugu movies"><div class="movie-content"><h3>Upcoming Telugu Movies 2026</h3><p>🎬 Telugu Movies</p><p>📍 Vijayawada</p><button class="btn" onclick="selectMovie('Upcoming Telugu Movies 2026')">Book Now</button></div></div>
<div class="movie"><img src="assets/m3.jpg" alt="Spirit"><div class="movie-content"><h3>Spirit</h3><p>🎬 Telugu Movie</p><p>📍 PVR Cinemas, Vijayawada</p><button class="btn" onclick="selectMovie('Spirit')">Book Now</button></div></div>
<div class="movie"><img src="assets/m4.webp" alt="Resident Evil"><div class="movie-content"><h3>Resident Evil</h3><p>🎬 Movie</p><p>📍 INOX Cinemas</p><button class="btn" onclick="selectMovie('Resident Evil')">Book Now</button></div></div>
</div></div></section>

<section id="register" class="page"><div class="section"><div class="card"><h2>Create Account</h2><p class="subtitle">Register before booking.</p><form onsubmit="register(event)"><label>Name</label><input id="rname" required><label>Email</label><input id="remail" type="email" required><label>Phone</label><input id="rphone" required><label>Password</label><input id="rpass" type="password" required><button class="btn" type="submit">Register</button></form><div id="rmsg"></div></div></div></section>
<section id="login" class="page"><div class="section"><div class="card"><h2>Customer Login</h2><p class="subtitle">Login to book and view tickets.</p><form onsubmit="login(event)"><label>Email</label><input id="lemail" type="email" required><label>Password</label><input id="lpass" type="password" required><button class="btn" type="submit">Login</button></form><div id="lmsg"></div><p style="text-align:center;margin-top:18px">New customer? <button style="border:0;background:none;color:#ff5366;font-weight:bold;cursor:pointer" onclick="show('register')">Register</button></p></div></div></section>

<section id="booking" class="page"><div class="section"><div class="card booking-card"><h2>Book Your Ticket</h2><p class="subtitle">Choose your seats.</p><label>Movie/Event</label><input id="event" value="Spirit" readonly><label>Date & Time</label><input id="date" value="05 October 2026 - 7:30 PM" readonly><label>Venue / Hall</label><input id="venue" value="PVR Cinemas, Vijayawada - Hall 1" readonly><div class="seat-head"><h3>Select Seats</h3><button class="small-btn" onclick="refreshSeats()">🔄 Refresh</button></div><div class="screen">SCREEN</div><div id="seatMap" class="seat-map"></div><div class="seat-legend"><span><i class="dot available"></i>Available</span><span><i class="dot selected"></i>Selected</span><span><i class="dot booked"></i>Booked</span></div><div class="summary"><strong>Selected:</strong> <span id="selectedSeats">None</span><br><strong>Total:</strong> ₹<span id="amount">0</span></div><button class="btn" style="width:100%;margin-top:18px" onclick="book()">Confirm Booking</button><div id="bmsg"></div></div></div></section>
<section id="myBookings" class="page"><div class="section"><div class="booking-list"><h2 style="text-align:center">My Bookings</h2><p class="subtitle">Your confirmed tickets.</p><div id="bookingList"></div></div></div></section>
<section id="ticket" class="page"><div class="section"><div class="ticket"><div class="ticket-main"><h2 style="color:#ff5366">DIGITAL E-TICKET</h2><h1 id="tevent"></h1><div class="ticket-row"><span>Booking ID</span><strong id="tid"></strong></div><div class="ticket-row"><span>Customer</span><strong id="tuser"></strong></div><div class="ticket-row"><span>Date</span><strong id="tdate"></strong></div><div class="ticket-row"><span>Venue</span><strong id="tvenue"></strong></div><div class="ticket-row"><span>Seats</span><strong id="tseats"></strong></div><div class="ticket-row"><span>Amount</span><strong>₹<span id="tamount"></span></strong></div><div class="actions"><button class="btn" onclick="window.print()">🖨 Print</button><button class="btn" onclick="show('myBookings')">My Bookings</button></div></div><div class="ticket-side"><div><div class="qr">▦</div><p>Show this ticket at the venue</p></div></div></div></div></section>
<footer>🎟️ QuickTicket • Online Ticket Booking Demo</footer>

<script>
const USERS_KEY='quickTicketUsers', BOOKINGS_KEY='quickTicketBookings', PRICE=250;
const users=()=>JSON.parse(localStorage.getItem(USERS_KEY)||'[]'), bookings=()=>JSON.parse(localStorage.getItem(BOOKINGS_KEY)||'[]');
const current=()=>JSON.parse(localStorage.getItem('quickTicketCurrentUser')||'null');
function show(id){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');if(id==='booking')refreshSeats();if(id==='myBookings')loadBookings()}
function msg(id,t,c){document.getElementById(id).innerHTML='<div class="msg '+c+'">'+t+'</div>'}
function register(e){e.preventDefault();let us=users(),email=remail.value.trim().toLowerCase();if(us.some(u=>u.email===email))return msg('rmsg','Email already registered.','error');us.push({id:'USR-'+Date.now(),name:rname.value.trim(),email,phone:rphone.value.trim(),password:rpass.value});localStorage.setItem(USERS_KEY,JSON.stringify(us));msg('rmsg','Registration successful!','success');setTimeout(()=>show('login'),700)}
function login(e){e.preventDefault();let u=users().find(x=>x.email===lemail.value.trim().toLowerCase()&&x.password===lpass.value);if(!u)return msg('lmsg','Invalid email or password.','error');localStorage.setItem('quickTicketCurrentUser',JSON.stringify({id:u.id,name:u.name,email:u.email,phone:u.phone}));msg('lmsg','Login successful! Welcome '+u.name+'.','success');setTimeout(()=>show('movies'),600)}
function selectMovie(name){event.value=name;if(name==='Upcoming Telugu Movies 2026'){date.value='10 October 2026 - 7:30 PM';venue.value='Vijayawada Cinemas - Hall 1'}else if(name==='Spirit'){date.value='05 October 2026 - 7:30 PM';venue.value='PVR Cinemas, Vijayawada - Hall 1'}else{date.value='15 October 2026 - 7:30 PM';venue.value='INOX Cinemas - Hall 1'}show('booking')}
function hallKey(){return `${event.value}|${date.value}|${venue.value}`}
function bookedSeats(){let s=new Set();bookings().filter(b=>b.hallKey===hallKey()).forEach(b=>(b.seatList||String(b.seats||'').split(',')).forEach(x=>x.trim()&&s.add(x.trim())));return s}
function refreshSeats(){let map=document.getElementById('seatMap');if(!map)return;let booked=bookedSeats(),selected=new Set((map.dataset.selected||'').split(',').filter(Boolean));map.innerHTML='';for(let r=0;r<3;r++)for(let n=1;n<=10;n++){let label=String.fromCharCode(65+r)+n,b=document.createElement('button');b.className='seat '+(booked.has(label)?'booked':selected.has(label)?'selected':'');b.textContent=label;b.disabled=booked.has(label);b.onclick=()=>{selected.has(label)?selected.delete(label):selected.add(label);map.dataset.selected=[...selected].join(',');refreshSeats()};map.appendChild(b)}document.getElementById('selectedSeats').textContent=[...selected].join(', ')||'None';document.getElementById('amount').textContent=selected.size*PRICE}
function book(){let u=current();if(!u)return msg('bmsg','Please login before booking.','error');let map=document.getElementById('seatMap'),seats=(map.dataset.selected||'').split(',').filter(Boolean);if(!seats.length)return msg('bmsg','Please select at least one seat.','error');let b={bookingId:'QT-'+Date.now(),customerId:u.id,customerName:u.name,event:event.value,date:date.value,venue:venue.value,seats:seats.join(', '),seatList:seats,totalAmount:seats.length*PRICE,status:'CONFIRMED',hallKey:hallKey()};let all=bookings();all.push(b);localStorage.setItem(BOOKINGS_KEY,JSON.stringify(all));localStorage.setItem('quickTicketLastBooking',JSON.stringify(b));map.dataset.selected='';renderTicket(b);show('ticket')}
function renderTicket(b){tevent.textContent=b.event;tid.textContent=b.bookingId;tuser.textContent=b.customerName;tdate.textContent=b.date;tvenue.textContent=b.venue;tseats.textContent=b.seats;tamount.textContent=b.totalAmount}
function loadBookings(){let u=current(),box=document.getElementById('bookingList');if(!u){box.innerHTML='<div class="booking-item">Please login to view bookings.</div>';return}let bs=bookings().filter(b=>b.customerId===u.id);box.innerHTML=bs.length?bs.map(b=>`<div class="booking-item"><h3>${b.event}</h3><p>📅 ${b.date}</p><p>📍 ${b.venue}</p><p>💺 ${b.seats}</p><p>💰 ₹${b.totalAmount}</p><button class="btn" onclick='renderTicket(${JSON.stringify(b)});show("ticket")'>View Ticket</button></div>`).join(''):'<div class="booking-item">No bookings yet.</div>'}
refreshSeats();
</script>
</body></html>
